// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  BRUNCH
  SNACK
}

enum IngredientCategory {
  PRODUCE
  PROTEIN
  DAIRY
  PANTRY
  SPICES
  FROZEN
  BEVERAGES
  OTHER
}

/// How a recipe entered the system — feeds the "agregar receta" flows
/// (manual, pegar texto libre + IA, o importar desde una URL/reel/tiktok).
enum RecipeSourceType {
  MANUAL
  TEXT_IMPORT
  URL_IMPORT
}

/// Estado del pipeline de importación en segundo plano (texto/URL + IA).
/// READY es el default porque las recetas manuales no pasan por este
/// pipeline y nunca deben quedar "atoradas" en PROCESSING.
enum RecipeImportStatus {
  PROCESSING
  READY
  FAILED
}

/// Estado de la generación de imagen en segundo plano (manual o disparada
/// automáticamente tras una importación exitosa).
enum RecipeImageStatus {
  NONE
  GENERATING
  READY
  FAILED
}

model Recipe {
  id          String     @id @default(cuid())
  name        String
  description String     @db.Text
  mealTypes   MealType[]

  /// Ruta interna (/api/recipe-images/[id]) una vez generada la imagen, no
  /// la URL externa de Kie (esa expira).
  imageUrl    String?
  imagePrompt String?    @db.Text

  baseServings       Int
  caloriesPerServing Int
  proteinGPerServing Float
  carbsGPerServing   Float
  fatGPerServing     Float

  /// Pasos de preparación, en orden.
  instructions String[]

  sourceType    RecipeSourceType @default(MANUAL)
  sourceUrl     String?
  sourceRawText String?          @db.Text

  /// PROCESSING mientras el pipeline de importación con IA sigue corriendo
  /// en segundo plano tras el redirect inicial (ver src/lib/recipe-import.ts).
  importStatus RecipeImportStatus @default(READY)
  importError  String?            @db.Text

  /// GENERATING mientras Kie/sharp siguen trabajando en segundo plano tras
  /// el redirect inicial (ver src/lib/recipe-image-generation.ts).
  imageStatus RecipeImageStatus @default(NONE)
  imageError  String?           @db.Text

  ingredients   Ingredient[]
  mealPlanItems MealPlanItem[]
  image         RecipeImage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Los bytes de la imagen viven en la DB (no en el filesystem del contenedor)
/// porque las URLs que da Kie expiran ~24h y Coolify no garantiza disco
/// persistente entre deploys. Se sirven via /api/recipe-images/[id].
model RecipeImage {
  id       String @id @default(cuid())
  recipeId String @unique
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  data     Bytes
  mimeType String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ingredient {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  name     String
  quantity Float
  unit     String

  category  IngredientCategory @default(OTHER)
  sortOrder Int                @default(0)

  @@index([recipeId])
}

model MealPlan {
  id            String   @id @default(cuid())
  name          String?
  /// Siempre normalizado a medianoche UTC del lunes de esa semana.
  weekStartDate DateTime @unique

  items         MealPlanItem[]
  shoppingLists ShoppingList[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MealPlanItem {
  id         String   @id @default(cuid())
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id])

  /// 0 = lunes ... 6 = domingo
  dayOfWeek Int
  mealType  MealType
  servings  Int

  @@index([mealPlanId])
  @@index([recipeId])
}

model ShoppingList {
  id         String    @id @default(cuid())
  mealPlanId String?
  mealPlan   MealPlan? @relation(fields: [mealPlanId], references: [id])

  items ShoppingListItem[]

  /// Marcada por Jorge cuando ya terminó de comprar todo. No se borra sola
  /// ni se filtra de /listas — solo se muestra atenuada/con badge.
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mealPlanId])
}

model ShoppingListItem {
  id             String       @id @default(cuid())
  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  name     String
  quantity Float?
  unit     String?
  category IngredientCategory @default(OTHER)

  isChecked       Boolean  @default(false)
  sourceRecipeIds String[]

  sortOrder Int @default(0)

  @@index([shoppingListId])
}
